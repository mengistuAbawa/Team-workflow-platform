
# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# Build output
dist/
build/
client/dist/
server/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Testing and coverage
coverage/
.nyc_output/

# Editor settings
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Local databases and backups
*.sqlite
*.sqlite3
*.db
*.sql.bak
*.dump

# Uploaded user files (ignore stored uploads, keep the folder)
server/uploads/*
!server/uploads/.gitkeep

# Frontend caches
.vite/
.cache/

# Package manager and tool caches
.eslintcache
.stylelintcache

# XAMPP local files
xampp/

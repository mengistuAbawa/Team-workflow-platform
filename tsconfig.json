{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "client/src/**/*.js",
    "client/src/**/*.jsx",
    "client/vite.config.js",
    "server/src/**/*.js"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/build"
  ],
  "typeAcquisition": {
    "enable": true
  }
}
